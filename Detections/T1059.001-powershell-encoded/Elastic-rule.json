{
  "rule_id": "d5736f51-935e-4437-b5af-f3ee9fde7f5e",
  "name": "Custom Detection - PowerShell Encoded Command (T1059.001)",
  "description": "Powershell encoded commands execution.",
  "risk_score": 73,
  "severity": "high",
  "type": "query",
  "language": "kuery",
  "query": "event.code: \"1\" and process.name: \"powershell.exe\" and process.command_line: (*-EncodedCommand* or *-enc * or *-ec *)",
  "index": [
    "winlogbeat-*"
  ],
  "interval": "5m",
  "from": "now-6m",
  "to": "now",
  "enabled": true,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0002",
        "name": "Execution",
        "reference": "https://attack.mitre.org/tactics/TA0002/"
      },
      "technique": [
        {
          "id": "T1059.001",
          "name": "PowerShell",
          "reference": "https://attack.mitre.org/techniques/T1059/001/"
        }
      ]
    }
  ]
}
